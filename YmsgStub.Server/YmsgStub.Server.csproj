<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Scrutor" Version="5.0.2" />
  </ItemGroup>

  <!-- 本地角色存档（Player:SaveFile）：Web SDK 默认把 *.json 当作 Content 复制到输出 / 发布目录，排除掉 -->
  <ItemGroup>
    <Content Remove="saves/**" />
    <None Remove="saves/**" />
  </ItemGroup>

  <!-- 游戏 DLL：本地引用，不随源码提交（见 .gitignore） -->
  <ItemGroup>
    <Reference Include="Google.Protobuf">
      <HintPath>..\libs\Metadata.Google.Protobuf.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\libs\Library.Assembly-CSharp.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
